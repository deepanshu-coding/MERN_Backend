# ─── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MongoDB Atlas ────────────────────────────────────────────
MONGODB_URI=

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ─── Admin ────────────────────────────────────────────────────
ADMIN_SECRET=

# ─── CORS (Cloudflare frontend URL) ───────────────────────────
FRONTEND_URL=
FRONTEND_URL_ALT=

# ─── Twilio (OTP via SMS) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Nodemailer (Email) ───────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM= <>

# ─── OTP Config ───────────────────────────────────────────────
OTP_EXPIRY_MINUTES=15
OTP_LENGTH=6
