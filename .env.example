# ─── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MongoDB Atlas ────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/soullink?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ─── Admin ────────────────────────────────────────────────────
ADMIN_SECRET=your_admin_secret_key

# ─── CORS (Cloudflare frontend URL) ───────────────────────────
FRONTEND_URL=https://soullink.pages.dev
FRONTEND_URL_ALT=https://soullinkco.com

# ─── Twilio (OTP via SMS) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ─── Nodemailer (Email) ───────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=soullinkco.pvt.ltd@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=SoulLink Co. <soullinkco.pvt.ltd@gmail.com>

# ─── OTP Config ───────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
